# Secrets & env
# NOTE: keep these rules ANCHORED or name-exact. A bare `secrets.yaml` rule matches in any
# directory and silently swallowed helm/templates/secrets.yaml (the chart's credential
# template), so a fresh clone rendered 0 Secrets. See docs/DECISIONS.md ADR-018.
.env
.env.*
!.env.example
*.key
.pexels_key
.unsplash_key
*.pem
*.crt
/secrets.yaml
/gateway-secrets.yaml
/woo-secrets.yaml
/pg-secret.yaml
/mariadb-secret.yaml

# Python
__pycache__/
*.py[cod]
*.pyo
.venv
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Dashboard
node_modules
node_modules/
src/dashboard/dist/
src/dashboard/.vite/
*.tsbuildinfo

# Helm
helm/charts/*.tgz
helm/Chart.lock

# Kube / local
kubeconfig
k3s.yaml
kind-kubeconfig

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Local tool state (Kilo)
.kilo/

# Artifacts (screenshots, live SSE dumps — not committed)
artifacts/

# Store photo sourcing: API cache + curation workspace (never committed)
store/photos-cache/
artifacts/store-photos/

# Design mockup PNG renders (regenerate with node design/mockups/shoot.mjs)
design/mockups/png/

# Logs & tmp
*.log
/tmp/

# Phase 5: transient store-chart staging for the provisioner image build
src/provisioner/chart/
