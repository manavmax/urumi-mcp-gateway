# Copy to `.env` (git-ignored) and fill in random values for the optional
# non-Kubernetes dev loop in docker-compose.yml. The Helm chart never reads this file —
# it generates the same credentials itself on first install.
#
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
MARIADB_ROOT_PASSWORD=
MARIADB_PASSWORD=
POSTGRES_PASSWORD=
