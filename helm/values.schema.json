{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Urumi values",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "domain": { "type": "string" },
        "ingressClass": { "type": "string", "enum": ["nginx", "traefik"] },
        "storageClass": { "type": "string" },
        "tlsEnabled": { "type": "boolean" }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "hosts": {
          "type": "object",
          "properties": {
            "store": { "type": "string" },
            "dashboard": { "type": "string" }
          },
          "required": ["store", "dashboard"]
        }
      }
    },
    "wordpress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "size": { "type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$" }
          }
        }
      }
    },
    "mariadb": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "storage": {
          "type": "object",
          "properties": { "size": { "type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$" } }
        }
      }
    },
    "postgres": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "storage": {
          "type": "object",
          "properties": { "size": { "type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$" } }
        },
        "persistence": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" } }
        }
      }
    },
    "gateway": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
    "wooMcp": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
    "dashboard": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
    "networkPolicy": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
    "storeAssets": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
    "wpSetup": { "type": "object", "properties": { "enabled": { "type": "boolean" } } }
  }
}
