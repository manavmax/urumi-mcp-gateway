{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "version-aware": true,
  "settings": {
    "appearanceTools": false,
    "layout": {
      "contentSize": "1280px",
      "wideSize": "1440px",
      "contentSizeVars": true
    },
    "useRootPaddingAwareAlignments": true,
    "color": {
      "custom": false,
      "defaultPalette": false,
      "palette": [
        { "name": "Ink", "slug": "ink", "color": "#14171C" },
        { "name": "Page", "slug": "page", "color": "#ECEBE7" },
        { "name": "Card", "slug": "card", "color": "#FFFFFF" },
        { "name": "Tile", "slug": "tile", "color": "#F3F2EF" },
        { "name": "Muted", "slug": "muted", "color": "#5F6673" },
        { "name": "Hairline", "slug": "hairline", "color": "#14171C" },
        { "name": "Periwinkle", "slug": "periwinkle", "color": "#B9C4DD" },
        { "name": "Lilac", "slug": "lilac", "color": "#D9C8DC" },
        { "name": "Peach", "slug": "peach", "color": "#EFCBBE" },
        { "name": "Sand", "slug": "sand", "color": "#E8DFD0" },
        { "name": "Sage", "slug": "sage", "color": "#D8E0D4" },
        { "name": "Clay Soft", "slug": "clay-soft", "color": "#EBD9CC" },
        { "name": "Accent", "slug": "accent", "color": "#A0522D" },
        { "name": "White", "slug": "white", "color": "#FFFFFF" }
      ],
      "gradients": [
        { "slug": "dusk", "name": "Dusk", "gradient": "linear-gradient(135deg, #B9C4DD 0%, #D9C8DC 52%, #EFCBBE 100%)" }
      ]
    },
    "spacing": {
      "units": [ "px", "rem", "em", "%", "vh", "vw" ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "name": "4", "slug": "4", "size": "4px" },
        { "name": "8", "slug": "8", "size": "8px" },
        { "name": "12", "slug": "12", "size": "12px" },
        { "name": "16", "slug": "16", "size": "16px" },
        { "name": "24", "slug": "24", "size": "24px" },
        { "name": "32", "slug": "32", "size": "32px" },
        { "name": "48", "slug": "48", "size": "48px" },
        { "name": "64", "slug": "64", "size": "64px" },
        { "name": "96", "slug": "96", "size": "96px" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "Inter",
          "slug": "inter",
          "name": "Inter",
          "fontFace": [
            {
              "fontFamily": "Inter",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": [ "file:./assets/fonts/inter-latin-wght-normal.woff2" ],
              "unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD"
            }
          ]
        },
        {
          "fontFamily": "Instrument Serif",
          "slug": "instrument-serif",
          "name": "Instrument Serif",
          "fontFace": [
            {
              "fontFamily": "Instrument Serif",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [ "file:./assets/fonts/instrument-serif-latin-400-normal.woff2" ],
              "unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD"
            },
            {
              "fontFamily": "Instrument Serif",
              "fontStyle": "italic",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [ "file:./assets/fonts/instrument-serif-latin-400-italic.woff2" ],
              "unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD"
            }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "14px" },
        { "slug": "body", "name": "Body", "size": "16px", "fluid": { "min": "16px", "max": "16px" } },
        { "slug": "medium", "name": "Medium", "size": "18px" },
        { "slug": "large", "name": "Large", "size": "20px" },
        { "slug": "x-large", "name": "X-Large", "size": "24px" },
        { "slug": "xx-large", "name": "XX-Large", "size": "32px" },
        { "slug": "section-title", "name": "Section title", "size": "clamp(32px, 4vw, 56px)", "fluid": false },
        { "slug": "hero-title", "name": "Hero title", "size": "clamp(56px, 8vw, 128px)", "fluid": false }
      ],
      "letterSpacing": {
        "label": "0.08em",
        "tight": "-0.02em",
        "normal": "0"
      },
      "fontStyle": [ "normal", "italic" ],
      "fontWeight": [ "400", "500", "600", "700" ],
      "textDecoration": [ "none", "underline" ],
      "textTransform": [ "none", "uppercase", "lowercase", "capitalize" ]
    },
    "custom": {
      "hairline": "rgba(20, 23, 28, 0.08)",
      "hairline-strong": "rgba(20, 23, 28, 0.12)",
      "nav-bg": "rgba(255, 255, 255, 0.86)",
      "ring": "rgba(185, 196, 221, 0.55)",
      "accent": "#A0522D",
      "radius": {
        "s": "12px",
        "card": "24px",
        "hero": "40px",
        "pill": "999px"
      },
      "shadow": {
        "card": "0 1px 2px rgba(20,23,28,0.04), 0 10px 30px rgba(20,23,28,0.05)",
        "pop": "0 2px 4px rgba(20,23,28,0.05), 0 16px 40px rgba(20,23,28,0.10)",
        "lift": "0 2px 4px rgba(20,23,28,0.06), 0 18px 44px rgba(20,23,28,0.11)",
        "contact": "0 20px 36px rgba(20,23,28,0.16)"
      },
      "motion": {
        "dur-fast": "150ms",
        "dur-mid": "300ms",
        "dur-slow": "700ms",
        "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)",
        "ease-spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
        "press": "0.97",
        "lift": "-3px",
        "float-y": "-4px",
        "float-dur": "8s"
      },
      "gutters": {
        "desktop": "24px",
        "mobile": "16px"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--page)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "fontSize": "16px",
      "lineHeight": "1.6",
      "letterSpacing": "0"
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--ink)" },
        "typography": { "textDecoration": "underline" }
      },
      "h1": { "typography": { "fontFamily": "var(--wp--preset--font-family--instrument-serif)", "fontSize": "var(--wp--preset--font-size--hero-title)", "lineHeight": "0.95", "letterSpacing": "-0.02em", "fontWeight": "400" } },
      "h2": { "typography": { "fontFamily": "var(--wp--preset--font-family--instrument-serif)", "fontSize": "var(--wp--preset--font-size--section-title)", "lineHeight": "1.05", "letterSpacing": "-0.01em", "fontWeight": "400" } },
      "h3": { "typography": { "fontFamily": "var(--wp--preset--font-family--inter)", "fontSize": "var(--wp--preset--font-size--large)", "lineHeight": "1.2", "fontWeight": "500" } },
      "h4": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "fontWeight": "600" } },
      "h5": { "typography": { "fontSize": "var(--wp--preset--font-size--body)", "fontWeight": "600" } },
      "h6": { "typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "600" } },
      "button": {
        "color": { "background": "var(--wp--preset--color--ink)", "text": "var(--wp--preset--color--white)" },
        "border": { "radius": "999px" },
        "typography": { "fontSize": "14px", "fontWeight": "500" }
      },
      "heading": { "color": { "text": "var(--wp--preset--color--ink)" } },
      "caption": { "color": { "text": "var(--wp--preset--color--muted)" } }
    },
    "blocks": {
      "core/group": { "spacing": { "padding": { "top": "0", "bottom": "0" } } }
    }
  },
  "templateParts": [
    { "name": "header", "area": "header" },
    { "name": "footer", "area": "footer" }
  ]
}
