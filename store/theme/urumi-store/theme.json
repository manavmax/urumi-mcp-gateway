{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "version-aware": true,
  "settings": {
    "appearanceTools": false,
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1360px",
      "contentSizeVars": true
    },
    "useRootPaddingAwareAlignments": true,
    "color": {
      "custom": false,
      "defaultPalette": false,
      "palette": [
        { "name": "Canvas", "slug": "canvas", "color": "#FBFBF9" },
        { "name": "Surface alt", "slug": "surface-alt", "color": "#F4F2EC" },
        { "name": "Surface raised", "slug": "surface-raised", "color": "#ECEAE4" },
        { "name": "Ink", "slug": "ink", "color": "#262525" },
        { "name": "Body", "slug": "body", "color": "#333333" },
        { "name": "Neutral 1", "slug": "neutral-1", "color": "#999999" },
        { "name": "Neutral 2", "slug": "neutral-2", "color": "#B8B8B8" },
        { "name": "Neutral 3", "slug": "neutral-3", "color": "#3E3E3D" },
        { "name": "Neutral 4", "slug": "neutral-4", "color": "#4C4C4C" },
        { "name": "Taupe", "slug": "taupe", "color": "#D2C5B7" },
        { "name": "Beige", "slug": "beige", "color": "#E8DFD0" },
        { "name": "Hairline", "slug": "hairline", "color": "#E1E1E0" },
        { "name": "Hover fill", "slug": "hover-fill", "color": "#1A1A1A" },
        { "name": "White", "slug": "white", "color": "#FFFFFF" }
      ],
      "gradients": [
        {
          "slug": "hero-veil",
          "name": "Hero veil",
          "gradient": "linear-gradient(180deg, rgba(72, 64, 54, 0.32) 0%, rgba(72, 64, 54, 0.12) 100%)"
        }
      ]
    },
    "spacing": {
      "units": [ "px", "rem", "em", "%", "vh", "vw" ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "name": "xxs", "slug": "xxs", "size": "4px" },
        { "name": "xs", "slug": "xs", "size": "8px" },
        { "name": "sm", "slug": "sm", "size": "12px" },
        { "name": "md", "slug": "md", "size": "16px" },
        { "name": "lg", "slug": "lg", "size": "20px" },
        { "name": "xl", "slug": "xl", "size": "24px" },
        { "name": "xxl", "slug": "xxl", "size": "28px" },
        { "name": "xxxl", "slug": "xxxl", "size": "32px" },
        { "name": "section", "slug": "section", "size": "36px" },
        { "name": "band", "slug": "band", "size": "40px" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": false,
      "fontFamilies": [
        {
          "fontFamily": "Hanken Grotesk Variable",
          "slug": "hanken",
          "name": "Hanken Grotesk",
          "fontFace": [
            {
              "fontFamily": "Hanken Grotesk Variable",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": [ "file:./assets/fonts/hanken-grotesk-latin-wght-normal.woff2" ],
              "unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD"
            }
          ]
        },
        {
          "fontFamily": "Newsreader Variable",
          "slug": "newsreader",
          "name": "Newsreader",
          "fontFace": [
            {
              "fontFamily": "Newsreader Variable",
              "fontStyle": "normal",
              "fontWeight": "200 800",
              "fontDisplay": "swap",
              "src": [ "file:./assets/fonts/newsreader-latin-wght-normal.woff2" ],
              "unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD"
            },
            {
              "fontFamily": "Newsreader Variable",
              "fontStyle": "italic",
              "fontWeight": "200 800",
              "fontDisplay": "swap",
              "src": [ "file:./assets/fonts/newsreader-latin-wght-italic.woff2" ],
              "unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD"
            }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "caption-xs", "name": "Caption XS", "size": "11px" },
        { "slug": "caption", "name": "Caption", "size": "12px" },
        { "slug": "label-caps", "name": "Label caps", "size": "12px" },
        { "slug": "ui-sm", "name": "UI small", "size": "13px" },
        { "slug": "small", "name": "Small", "size": "14px" },
        { "slug": "body", "name": "Body", "size": "16px" },
        { "slug": "body-lg", "name": "Body large", "size": "18px" },
        { "slug": "heading-sm", "name": "Heading S", "size": "20px" },
        { "slug": "heading-md", "name": "Heading M", "size": "22px" },
        { "slug": "heading-lg", "name": "Heading L", "size": "24px" },
        { "slug": "heading-xl", "name": "Heading XL", "size": "28px" },
        { "slug": "display", "name": "Display", "size": "clamp(30px, 3vw, 40px)" },
        { "slug": "intro", "name": "Intro", "size": "22px" }
      ],
      "letterSpacing": {
        "label": "0.04em",
        "button": "0.02em",
        "tight": "-0.2px",
        "normal": "0"
      },
      "fontStyle": [ "normal", "italic" ],
      "fontWeight": [ "400", "500" ],
      "textDecoration": [ "none", "underline" ],
      "textTransform": [ "none", "uppercase" ]
    },
    "custom": {
      "hairline": "#E1E1E0",
      "hover-fill": "#1A1A1A",
      "overlay": "rgba(72, 64, 54, 0.20)",
      "motion": {
        "fast": "200ms",
        "base": "300ms",
        "slow": "500ms",
        "ease": "cubic-bezier(0.2, 0.7, 0.2, 1)"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--canvas)",
      "text": "var(--wp--preset--color--body)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--newsreader-variable)",
      "fontSize": "16px",
      "fontWeight": "500",
      "lineHeight": "1.35"
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--ink)" },
        "typography": { "textDecoration": "none" }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--newsreader-variable)",
          "fontWeight": "500",
          "lineHeight": "1.2",
          "letterSpacing": "-0.2px"
        }
      },
      "h1": { "typography": { "fontFamily": "var(--wp--preset--font-family--newsreader-variable)", "fontSize": "var(--wp--preset--font-size--heading-xl)", "fontWeight": "500", "lineHeight": "1.2" } },
      "h2": { "typography": { "fontFamily": "var(--wp--preset--font-family--newsreader-variable)", "fontSize": "var(--wp--preset--font-size--heading-lg)", "fontWeight": "500", "lineHeight": "1.2" } },
      "h3": { "typography": { "fontFamily": "var(--wp--preset--font-family--newsreader-variable)", "fontSize": "var(--wp--preset--font-size--heading-md)", "fontWeight": "500", "lineHeight": "1.2" } },
      "h4": { "typography": { "fontFamily": "var(--wp--preset--font-family--newsreader-variable)", "fontSize": "var(--wp--preset--font-size--heading-sm)", "fontWeight": "500", "lineHeight": "1.2" } },
      "h5": { "typography": { "fontSize": "16px", "fontWeight": "500" } },
      "h6": { "typography": { "fontSize": "16px", "fontWeight": "500" } },
      "button": {
        "color": { "background": "var(--wp--preset--color--body)", "text": "var(--wp--preset--color--canvas)" },
        "border": { "radius": "0px" },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--hanken-grotesk-variable)",
          "fontSize": "13px",
          "fontWeight": "400",
          "letterSpacing": "0.26px",
          "textTransform": "uppercase",
          "lineHeight": "1.35"
        },
        "spacing": { "padding": { "top": "12px", "bottom": "12px", "left": "24px", "right": "24px" } }
      },
      "caption": { "color": { "text": "var(--wp--preset--color--neutral-3)" } }
    },
    "blocks": {
      "core/group": { "spacing": { "padding": { "top": "0", "bottom": "0" } } }
    }
  },
  "templateParts": [
    { "name": "header", "area": "header" },
    { "name": "footer", "area": "footer" }
  ]
}
