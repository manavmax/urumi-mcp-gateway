
from chat.model_discovery import ModelDiscovery, ModelInfo


def test_parse_version():
    from chat.model_discovery import _parse_version
    # Normal case
    assert _parse_version("models/gemini-3.5-flash") == (3, 5)
    assert _parse_version("models/gemini-10.0-pro") == (10, 0)
    assert _parse_version("models/gemini-1.5-flash-lite") == (1, 5)
    # No version-like pattern
    assert _parse_version("models/gemma-4-26b-it") == (0, 0)
    assert _parse_version("models/something-else") == (0, 0)


def test_rank_models_numeric_version():
    # Create dummy ModelInfo objects
    m1 = ModelInfo(id="models/gemini-9.0-flash", owned_by="google", supports_tools=False, last_probe_time=0, last_probe_error=None)
    m2 = ModelInfo(id="models/gemini-10.0-flash", owned_by="google", supports_tools=False, last_probe_time=0, last_probe_error=None)
    m3 = ModelInfo(id="models/gemini-8.5-pro", owned_by="google", supports_tools=False, last_probe_time=0, last_probe_error=None)
    models = [m1, m2, m3]
    discovery = ModelDiscovery()
    ranked = discovery._rank_models(models)
    # Expect descending version: 10.0, 9.0, 8.5
    assert ranked[0].id == "models/gemini-10.0-flash"
    assert ranked[1].id == "models/gemini-9.0-flash"
    assert ranked[2].id == "models/gemini-8.5-pro"


def test_rank_models_tier_within_same_version():
    # Same version, different tiers
    m1 = ModelInfo(id="models/gemini-1.5-flash", owned_by="google", supports_tools=False, last_probe_time=0, last_probe_error=None)
    m2 = ModelInfo(id="models/gemini-1.5-pro", owned_by="google", supports_tools=False, last_probe_time=0, last_probe_error=None)
    m3 = ModelInfo(id="models/gemini-1.5-flash-lite", owned_by="google", supports_tools=False, last_probe_time=0, last_probe_error=None)
    models = [m1, m2, m3]
    discovery = ModelDiscovery()
    ranked = discovery._rank_models(models)
    # Expected order: pro (tier 3) > flash (tier 2) > flash-lite (tier 1)
    assert ranked[0].id == "models/gemini-1.5-pro"
    assert ranked[1].id == "models/gemini-1.5-flash"
    assert ranked[2].id == "models/gemini-1.5-flash-lite"


def test_rank_models_suffix_tiebreaker():
    # Same version and tier, different suffix; should sort by id descending (lexicographically) as tiebreaker
    m1 = ModelInfo(id="models/gemini-1.5-flash-abc", owned_by="google", supports_tools=False, last_probe_time=0, last_probe_error=None)
    m2 = ModelInfo(id="models/gemini-1.5-flash-def", owned_by="google", supports_tools=False, last_probe_time=0, last_probe_error=None)
    models = [m1, m2]
    discovery = ModelDiscovery()
    ranked = discovery._rank_models(models)
    # Since we sort reverse=True, higher id lexicographically comes first.
    # "def" > "abc", so m2 should be first.
    assert ranked[0].id == "models/gemini-1.5-flash-def"
    assert ranked[1].id == "models/gemini-1.5-flash-abc"


def test_exclude_non_gemini_and_gemma():
    # We'll test the filtering logic by calling _filter_text_chat_models with a list of raw model dicts.
    # We need to mock settings to have no min_version, no exclude patterns.
    from unittest.mock import patch

    discovery = ModelDiscovery()
    raw_models = [
        {"id": "models/gemini-1.5-flash"},
        {"id": "models/gemma-4-26b-it"},
        {"id": "models/some-other-model"},
        {"id": "models/gemini-2.0-pro"},
        {"id": "models/embed-001"},
        {"id": "models/image-generation"},
    ]
    with patch('chat.model_discovery.get_settings') as mock_get_settings:
        mock_settings = mock_get_settings.return_value
        mock_settings.min_version_filter.return_value = ""
        mock_settings.exclude_patterns.return_value = []
        # Call the private method
        filtered = discovery._filter_text_chat_models(raw_models)
        # Expect only gemini-1.5-flash and gemini-2.0-pro remain (others excluded)
        ids = [m.id for m in filtered]
        assert set(ids) == {"models/gemini-1.5-flash", "models/gemini-2.0-pro"}
        # Ensure gemma and non-gemini and embed/image are excluded
        assert "models/gemma-4-26b-it" not in ids
        assert "models/some-other-model" not in ids
        assert "models/embed-001" not in ids
        assert "models/image-generation" not in ids
